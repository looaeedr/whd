{
  "schema": "WHD_CHANGE_TEST_PROFILE_V1",
  "version": 2,
  "status": "CURRENT",
  "owner": "tools/change_test_profile.py",
  "purpose": "Deterministically select required QA stages from change intent and affected domains. Targeted tests never replace the final full gate for non-doc changes.",
  "workspace": {
    "root_policy": "EXECUTOR_LOCAL_REPO_WORKSPACE",
    "production_branch": "cleanup/2d-3d-sync",
    "production_baseline": "GITHUB_PRODUCTION_X",
    "drive_role": "MIRROR_BACKUP_ONLY",
    "drive_required": false,
    "shared_zero_required": false,
    "policy": "WORKSPACE_FIRST_GIT_BASELINE",
    "github_role": "production baseline + delivery/PR/CI/control-plane; repository authoring happens in executor-local workspace"
  },
  "primary_change_types": {
    "BUGFIX": [
      "REPRODUCER_RED",
      "TARGETED_REGRESSION",
      "AFFECTED_SUBSYSTEM",
      "INTEGRATION"
    ],
    "FEATURE": [
      "FEATURE_ACCEPTANCE",
      "UNIT_OR_COMPONENT",
      "AFFECTED_SUBSYSTEM",
      "INTEGRATION"
    ],
    "UPDATE": [
      "COMPATIBILITY",
      "MIGRATION_CONFIG",
      "AFFECTED_SUBSYSTEM",
      "INTEGRATION"
    ],
    "REFACTOR": [
      "BEHAVIORAL_EQUIVALENCE",
      "UNIT",
      "INTEGRATION"
    ],
    "GOVERNANCE": [
      "CONTRACT",
      "CONTROL_PLANE_REGRESSION",
      "AUTHORITY_CONSISTENCY"
    ],
    "DOCS_METADATA": [
      "SCHEMA_LINT_LINK"
    ]
  },
  "domain_overlays": {
    "UI": [
      "UI_CONTRACT_STATE",
      "TK_XVFB",
      "VISUAL_ACCEPTANCE"
    ],
    "GEOMETRY": [
      "GEOMETRY_INVARIANTS",
      "DXF_ACCEPTANCE",
      "RENDERER_SYNC",
      "SAVE_RELOAD"
    ]
  },
  "final_full_gate": {
    "product_or_behavior_change": "PRODUCT_FULL_REGRESSION",
    "governance_only_change": "GOVERNANCE_FULL_SUITE",
    "docs_metadata_only_change": "NONE",
    "rule": "Every non-doc change must finish with the appropriate full gate before ACCEPT/CLOSE. Focused/targeted suites are additive and cannot replace it."
  },
  "classification": {
    "explicit_type_overrides_inference": true,
    "ambiguity_policy": "FAIL_CLOSED_REQUIRE_EXPLICIT_CHANGE_TYPE",
    "required_inputs": [
      "task",
      "changed_files"
    ],
    "output_fields": [
      "change_type",
      "domains",
      "required_stages",
      "full_gate_kind",
      "full_gate_required",
      "profile_id",
      "exact_commands",
      "command_owner"
    ],
    "recompute_on_changed_files_expansion": true,
    "focused_tests_can_replace_full_gate": false
  },
  "execution_commands": {
    "owner": "tools/change_test_profile.py",
    "governance_full_suite": [
      "python tools/control_plane_regression.py"
    ],
    "product_full_regression": [
      "python -m pytest -q"
    ],
    "github_actions_policy": "WORKFLOW_MUST_CALL_PROFILE_COMMAND_OWNER_NOT_DUPLICATE_TEST_LIST",
    "root_policy": "ROOT_MUST_RUN_EXACT_PROFILE_COMMANDS_BEFORE_DIFF_FREEZE"
  },
  "delivery_scope_policy": {
    "classification_owner": "tools/change_test_profile.py",
    "docs": "governance/skills/AGENTS/process authority/governance tests/human docs",
    "body": "product code/tests/UI/renderer/geometry/manufacturing/product-required docs",
    "shared_zero_routing": "RETIRED",
    "post_merge_zero_test_required": false
  }
}
