{
  "schema_version": 1,
  "contract": "WHD_DISPATCH_TURN_EXIT_GATE_V1",
  "purpose": "product /派工 turn-exit decision consistency; not a ChatGPT platform execution hook",
  "required_observation_fields": [
    "issue",
    "pr",
    "base_branch",
    "pr_head_sha",
    "run_id",
    "run_head_sha",
    "run_status",
    "run_conclusion",
    "last_observation",
    "next_exact_action"
  ],
  "nonterminal_statuses": [
    "requested",
    "queued",
    "waiting",
    "pending",
    "in_progress"
  ],
  "red_conclusions": [
    "failure",
    "cancelled",
    "timed_out",
    "action_required",
    "startup_failure",
    "stale"
  ],
  "decisions": {
    "RUN_OR_HEAD_MISSING_OR_MISMATCH": {
      "action": "RECONCILE_ONLY",
      "normal_completion": false,
      "may_end_turn_without_completion": false
    },
    "CI_NONTERMINAL": {
      "action": "CONTINUE_POLL",
      "normal_completion": false,
      "may_end_turn_without_completion": false
    },
    "CI_TERMINAL_RED": {
      "action": "REPAIR_AND_RETEST",
      "normal_completion": false,
      "may_end_turn_without_completion": false
    },
    "CI_EXACT_SUCCESS_LOCALX_PENDING": {
      "action": "LOCALX_INTEGRATION_PENDING",
      "normal_completion": false,
      "may_end_turn_without_completion": false
    },
    "CI_EXACT_SUCCESS_REMAINING_DELIVERY": {
      "action": "CONTINUE_FINALIZATION",
      "normal_completion": false,
      "may_end_turn_without_completion": false
    },
    "FULL_DELIVERY_READBACK": {
      "action": "RELEASED",
      "normal_completion": true,
      "may_end_turn_without_completion": false
    },
    "VERIFIED_EXTERNAL_BLOCKER": {
      "action": "BLOCKED_WITH_EVIDENCE",
      "normal_completion": false,
      "may_end_turn_without_completion": true,
      "requires": [
        "blocker",
        "last_observation",
        "next_exact_action"
      ]
    },
    "REAL_RUNTIME_LIMIT": {
      "action": "RUNTIME_LIMIT_UNRESOLVED",
      "normal_completion": false,
      "may_end_turn_without_completion": true,
      "requires": [
        "limit_evidence",
        "last_observation",
        "next_exact_action"
      ]
    }
  },
  "ordering": [
    "REAL_RUNTIME_LIMIT",
    "VERIFIED_EXTERNAL_BLOCKER",
    "RUN_OR_HEAD_MISSING_OR_MISMATCH",
    "CI_NONTERMINAL",
    "CI_TERMINAL_RED",
    "CI_EXACT_SUCCESS_LOCALX_PENDING",
    "CI_EXACT_SUCCESS_REMAINING_DELIVERY",
    "FULL_DELIVERY_READBACK"
  ],
  "restrictions": [
    "No normal exit while CI is nonterminal and tools remain available",
    "No stale HEAD success reuse",
    "No X product publish without /推推",
    "No new recurring schedule or workflow_run coding agent",
    "No DC access (including list_devices or ping) without explicit current device/operation authorization and external approval",
    "Same-issue default GitHub localX merge requires exact CI GREEN, mergeability, verified base change impact and expected HEAD",
    "Windows localX sync and manual UAT remain independently pending unless verified",
    "No force/reset and no product X publish without user /推推"
  ],
  "integration_routes": {
    "GITHUB_LOCALX_FIRST": {
      "requires": [
        "same_issue_execution_authorization",
        "exact_ci_success",
        "pr_base_localX",
        "mergeable_pr",
        "base_change_impact_checked",
        "expected_head_sha"
      ],
      "on_success": "GITHUB_LOCALX_MERGED + WINDOWS_LOCALX_SYNC_PENDING",
      "forbids": [
        "unapproved_dc_probe",
        "pretending_windows_is_synced",
        "publishing_product_x",
        "force_reset"
      ]
    },
    "EXPLICIT_DC_LOCALX": {
      "requires": [
        "explicit_current_dc_device_and_operation_authorization",
        "external_dc_approval",
        "exact_ci_success",
        "pr_base_localX"
      ],
      "on_success": "LOCALX_SYNCED only after safe merge and both SHA readback"
    }
  },
  "default_integration_route": "GITHUB_LOCALX_FIRST",
  "route_selection_order": [
    "Use EXPLICIT_DC_LOCALX only when the user explicitly requests scoped DC and external platform approves",
    "Otherwise after exact CI success and same-scope BUG/dispatch authorization: GITHUB_LOCALX_FIRST without contacting DC",
    "On CI RED, PR conflict, permissions denial or unknown base drift: BLOCKED_WITH_EVIDENCE, not force or DC workaround"
  ],
  "route_readback_invariants": {
    "GITHUB_LOCALX_FIRST": "GITHUB_LOCALX_MERGED + WINDOWS_LOCALX_SYNC_PENDING; workstation SHA and UAT unverified",
    "EXPLICIT_DC_LOCALX": "LOCALX_SYNCED only after successful local safe merge, nonforce remote sync and both SHA readback"
  }
}
