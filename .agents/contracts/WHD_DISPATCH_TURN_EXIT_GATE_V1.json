{
  "schema_version": 1,
  "contract": "WHD_DISPATCH_TURN_EXIT_GATE_V1",
  "purpose": "product /派工 turn-exit decision consistency; not a ChatGPT platform execution hook",
  "required_observation_fields": [
    "issue",
    "pr",
    "base_branch",
    "pr_head_sha",
    "run_id",
    "run_head_sha",
    "run_status",
    "run_conclusion",
    "last_observation",
    "next_exact_action"
  ],
  "nonterminal_statuses": [
    "requested",
    "queued",
    "waiting",
    "pending",
    "in_progress"
  ],
  "red_conclusions": [
    "failure",
    "cancelled",
    "timed_out",
    "action_required",
    "startup_failure",
    "stale"
  ],
  "decisions": {
    "RUN_OR_HEAD_MISSING_OR_MISMATCH": {
      "action": "RECONCILE_ONLY",
      "normal_completion": false,
      "may_end_turn_without_completion": false
    },
    "CI_NONTERMINAL": {
      "action": "CONTINUE_POLL",
      "normal_completion": false,
      "may_end_turn_without_completion": false
    },
    "CI_TERMINAL_RED": {
      "action": "REPAIR_AND_RETEST",
      "normal_completion": false,
      "may_end_turn_without_completion": false
    },
    "CI_EXACT_SUCCESS_LOCALX_PENDING": {
      "action": "LOCALX_INTEGRATION_PENDING",
      "normal_completion": false,
      "may_end_turn_without_completion": false
    },
    "CI_EXACT_SUCCESS_REMAINING_DELIVERY": {
      "action": "CONTINUE_FINALIZATION",
      "normal_completion": false,
      "may_end_turn_without_completion": false
    },
    "FULL_DELIVERY_READBACK": {
      "action": "RELEASED",
      "normal_completion": true,
      "may_end_turn_without_completion": false
    },
    "VERIFIED_EXTERNAL_BLOCKER": {
      "action": "BLOCKED_WITH_EVIDENCE",
      "normal_completion": false,
      "may_end_turn_without_completion": true,
      "requires": [
        "blocker",
        "last_observation",
        "next_exact_action"
      ]
    },
    "REAL_RUNTIME_LIMIT": {
      "action": "RUNTIME_LIMIT_UNRESOLVED",
      "normal_completion": false,
      "may_end_turn_without_completion": true,
      "requires": [
        "limit_evidence",
        "last_observation",
        "next_exact_action"
      ]
    }
  },
  "ordering": [
    "REAL_RUNTIME_LIMIT",
    "VERIFIED_EXTERNAL_BLOCKER",
    "RUN_OR_HEAD_MISSING_OR_MISMATCH",
    "CI_NONTERMINAL",
    "CI_TERMINAL_RED",
    "CI_EXACT_SUCCESS_LOCALX_PENDING",
    "CI_EXACT_SUCCESS_REMAINING_DELIVERY",
    "FULL_DELIVERY_READBACK"
  ],
  "restrictions": [
    "No normal exit while CI is nonterminal and tools remain available",
    "No stale HEAD success reuse",
    "No X product publish without /推推",
    "No DC before exact CI success and LOCALX_INTEGRATION",
    "No new recurring schedule or workflow_run coding agent",
    "No GitHub-only merge merely from no-DC wording without explicit same-issue remote localX integration approval"
  ],
  "integration_routes": {
    "DC_LOCALX_FIRST": {
      "requires": [
        "exact_ci_success",
        "pr_base_localX",
        "local_machine_integration_authorized_by_existing_gate"
      ],
      "on_success": "LOCALX_SYNCED"
    },
    "DC_UNREACHABLE_FALLBACK": {
      "requires": [
        "exact_ci_success",
        "pr_base_localX",
        "verified_dc_connection_failure"
      ],
      "on_success": "DC_UNREACHABLE + LOCALX_SYNC_PENDING"
    },
    "GITHUB_ONLY_EXPLICIT_SCOPE": {
      "requires": [
        "exact_ci_success",
        "pr_base_localX",
        "user_explicit_remote_localX_merge_authorization_for_same_issue_pr",
        "user_no_dc_scope",
        "mergeable_pr",
        "expected_head_sha"
      ],
      "on_success": "GITHUB_ONLY_LOCALX_MERGED + LOCALX_SYNC_PENDING",
      "forbids": [
        "fabricated_dc_disconnection",
        "assuming_local_localX_head",
        "silently_using_pr_body_as_user_authorization"
      ]
    }
  }
}
